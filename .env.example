# Valores padrao para desenvolvimento local (fora do Docker).
# Dentro do compose, DATABASE_URL aponta para o servico "db".
DATABASE_URL=postgresql+psycopg://appmax:appmax@localhost:5432/appmax
AUTHORIZER_URL=https://util.devi.tools/api/v2/authorize
NOTIFIER_URL=https://util.devi.tools/api/v1/notify
EXTERNAL_TIMEOUT_SECONDS=5.0
